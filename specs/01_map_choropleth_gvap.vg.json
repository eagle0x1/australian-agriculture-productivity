{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 470,
  "height": 370,
  "params": [
    {
      "name": "metricSelect",
      "value": "GVAP_Billion_AUD",
      "bind": {
        "input": "select",
        "options": [
          "GVAP_Billion_AUD",
          "TFP_Annual_Growth_Pct",
          "Cropping_Share_Pct",
          "Water_Efficiency_Index"
        ],
        "labels": [
          "Gross Value of Production ($B AUD)",
          "Annual TFP Growth (% p.a.)",
          "Cropping Share of Output (%)",
          "Water Efficiency Index (1990=100)"
        ],
        "name": "Select Map Metric: "
      }
    }
  ],
  "projection": {
    "type": "mercator",
    "center": [
      134.0,
      -28.2
    ],
    "scale": 550
  },
  "layer": [
    {
      "data": {
        "url": "data/au_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "calculate": "datum.properties[metricSelect]",
          "as": "ActiveValue"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#FBF8F3",
        "strokeWidth": 2
      },
      "encoding": {
        "color": {
          "field": "ActiveValue",
          "type": "quantitative",
          "scale": {
            "scheme": "ygnbu",
            "zero": false
          },
          "legend": {
            "title": "Selected Metric",
            "orient": "right",
            "gradientLength": 140
          }
        },
        "tooltip": [
          {
            "field": "properties.STATE_NAME",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "ActiveValue",
            "type": "quantitative",
            "title": "Selected Metric Value",
            "format": ".2f"
          },
          {
            "field": "properties.GVAP_Billion_AUD",
            "type": "quantitative",
            "title": "Gross Value ($B AUD)",
            "format": ".1f"
          },
          {
            "field": "properties.TFP_Annual_Growth_Pct",
            "type": "quantitative",
            "title": "Annual TFP Growth (% p.a.)",
            "format": ".2f"
          },
          {
            "field": "properties.Cropping_Share_Pct",
            "type": "quantitative",
            "title": "Cropping Share (%)"
          },
          {
            "field": "properties.Water_Efficiency_Index",
            "type": "quantitative",
            "title": "Water Efficiency Index"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/state_ag_metrics.csv"
      },
      "transform": [
        {
          "filter": "datum.State_Code != 'ACT'"
        },
        {
          "calculate": "datum[metricSelect]",
          "as": "ActiveVal"
        },
        {
          "calculate": "datum.State_Code + ': ' + datum.ActiveVal + (metricSelect == 'GVAP_Billion_AUD' ? 'B' : metricSelect == 'Water_Efficiency_Index' ? '' : '%')",
          "as": "StateLabel"
        }
      ],
      "mark": {
        "type": "text",
        "fontWeight": "bold",
        "fontSize": 11.5,
        "fill": "#132A20"
      },
      "encoding": {
        "longitude": {
          "field": "Lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Lat",
          "type": "quantitative"
        },
        "text": {
          "field": "StateLabel",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "Lon": 120.5,
            "Lat": -35.8,
            "Note": "WA leads TFP growth (+1.92% p.a.)"
          },
          {
            "Lon": 147.0,
            "Lat": -40.2,
            "Note": "MDB drives NSW & VIC $45B+ output"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontStyle": "italic",
        "fontWeight": 700,
        "fill": "#C85A32"
      },
      "encoding": {
        "longitude": {
          "field": "Lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Lat",
          "type": "quantitative"
        },
        "text": {
          "field": "Note",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "font": "Source Sans 3, sans-serif",
    "autosize": {
      "type": "fit",
      "contains": "padding"
    },
    "axis": {
      "labelFontSize": 11.5,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#232725",
      "labelColor": "#454D48",
      "gridColor": "#EAE3D2",
      "domainColor": "#C7BFA8"
    },
    "legend": {
      "labelFontSize": 11.5,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#1E4D3B"
    },
    "view": {
      "stroke": "transparent"
    }
  }
}